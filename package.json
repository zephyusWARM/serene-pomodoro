{
  "name": "serene-guardian",
  "version": "3.1.1",
  "description": "A serene health guardian that breaks prolonged sitting and protects your eyes with the 20-20-20 rule",
  "author": "Your Name",
  "private": true,
  "repository": "zephyusWARM/serene-pomodoro",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run.mjs build",
    "lint": "node scripts/run.mjs lint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "node scripts/run.mjs dist:win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "test": "node scripts/run.mjs unit",
    "qa:electron": "node scripts/run.mjs build && node scripts/run.mjs electron",
    "quality": "node scripts/run.mjs quality",
    "skills:check": "node scripts/skills-check.mjs",
    "skills:sync": "node scripts/skills-bootstrap.mjs",
    "bridge": "node scripts/agent-bridge/bridge.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.sereneguardian.app",
    "productName": "Serene Guardian",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serene Guardian"
    }
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
